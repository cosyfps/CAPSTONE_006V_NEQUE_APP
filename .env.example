# Copiar a `.env` (no se versiona) y completar con los datos del proyecto Supabase:
# Project Settings -> API Keys. Nunca subir claves reales al repositorio.

SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publica: `sb_publishable_...` (o la `anon` heredada).
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: `sb_secret_...` (o la `service_role` heredada). Solo servidor.
SUPABASE_SECRET_KEY=
# Origenes web permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:8080
